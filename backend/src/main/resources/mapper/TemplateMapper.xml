<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.materialmaker.mapper.TemplateMapper">
    <resultMap id="BaseResultMap" type="com.materialmaker.model.Template">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="category" property="category"/>
        <result column="cover_url" property="coverUrl"/>
        <result column="description" property="description"/>
        <result column="required_image_count" property="requiredImageCount"/>
        <result column="accepted_mime_types" property="acceptedMimeTypes"/>
        <result column="max_file_size_bytes" property="maxFileSizeBytes"/>
        <result column="enabled" property="enabled"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findAllEnabled" resultMap="BaseResultMap">
        SELECT * FROM templates
        WHERE enabled = 1
        <if test="category != null and category != ''">
            AND category = #{category}
        </if>
        ORDER BY sort_order ASC, created_at ASC
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM templates WHERE id = #{id} AND enabled = 1
    </select>
</mapper>
